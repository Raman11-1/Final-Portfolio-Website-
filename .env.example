# Copy this file to .env locally if you ever want to run `vercel dev` and
# test the chat function on your own machine. Never commit the real .env.
#
# In production, this is set in the Vercel dashboard instead:
# Project -> Settings -> Environment Variables -> add MISTRAL_API_KEY.
#
# Get a key from https://console.mistral.ai. Keys are scoped to a Workspace
# and inherit that workspace's model access, quota, and rate limits.

MISTRAL_API_KEY=
