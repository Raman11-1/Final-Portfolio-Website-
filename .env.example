# Copy this file to .env locally if you ever want to run `vercel dev` and
# test the chat function on your own machine. Never commit the real .env.
#
# In production, this is set in the Vercel dashboard instead:
# Project -> Settings -> Environment Variables -> add GEMINI_API_KEY.
#
# Get a key from https://aistudio.google.com/apikey

GEMINI_API_KEY=
